{
  "type": "stack",
  "props": { "gap": "md" },
  "children": [
    { "type": "heading", "props": { "text": "Translator", "level": 2 } },
    {
      "type": "select",
      "id": "translation-direction",
      "bind": "direction",
      "action": "setDirection",
      "props": {
        "label": "Direction",
        "options": [
          { "value": "ko-en", "label": "Korean → English" },
          { "value": "en-ko", "label": "English → Korean" }
        ]
      }
    },
    { "type": "textarea", "id": "source-text", "bind": "source", "action": "setSource", "props": { "label": "Text", "placeholder": "Enter text to translate…" } },
    { "type": "button", "id": "translate", "action": "translate", "props": { "label": "Translate" } },
    { "type": "card", "children": [{ "type": "text", "bind": "result" }] },
    { "type": "divider" },
    { "type": "heading", "props": { "text": "History", "level": 3 } },
    { "type": "empty-state", "bind": "history", "props": { "text": "No translations yet." } },
    {
      "type": "list",
      "bind": "history",
      "children": [
        {
          "type": "card",
          "children": [
            { "type": "badge", "bind": "$item.direction" },
            { "type": "text", "bind": "$item.source" },
            { "type": "text", "bind": "$item.result" },
            { "type": "button", "action": "remove", "props": { "label": "Delete", "variant": "danger", "args": { "id": "$item._id" } } }
          ]
        }
      ]
    }
  ]
}
