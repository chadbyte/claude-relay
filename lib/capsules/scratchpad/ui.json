{
  "type": "stack",
  "props": { "gap": "xl" },
  "children": [
    {
      "type": "stack",
      "props": { "gap": "xs" },
      "children": [
        { "type": "text", "props": { "text": "Quick capture", "role": "caption", "tone": "accent" } },
        { "type": "heading", "props": { "text": "Scratchpad", "level": 2, "role": "display" } },
        { "type": "text", "props": { "text": "Keep the small things close while you work.", "role": "muted" } }
      ]
    },
    {
      "type": "card",
      "props": { "variant": "raised", "padding": "lg" },
      "children": [
        {
          "type": "row",
          "props": { "align": "end", "gap": "sm" },
          "children": [
            { "type": "input", "id": "scratch-input", "bind": "draft", "action": "setDraft", "props": { "label": "New note", "hint": "Captured notes stay in this Capsule.", "placeholder": "Write something…", "validation": { "maxLength": 2000, "message": "Notes can contain up to 2,000 characters." } } },
            { "type": "button", "id": "add-note", "action": "add", "props": { "label": "Add note", "variant": "primary", "icon": "plus" } }
          ]
        }
      ]
    },
    {
      "type": "section",
      "props": { "label": "Notes", "accessibleLabel": "Saved notes", "gap": "sm" },
      "children": [
        { "type": "input", "id": "scratch-filter", "bind": "filter", "action": "setFilter", "props": { "label": "Filter notes", "inputType": "search", "placeholder": "Find a note…" } },
        { "type": "empty-state", "bind": "items", "props": { "icon": "notebook-pen", "title": "Nothing captured yet", "text": "Add a note to begin your scratchpad." } },
        {
          "type": "list",
          "bind": "items",
          "props": { "variant": "cards", "gap": "sm", "filter": { "$bind": "filter" }, "filterKey": "text", "sortKey": "createdAt", "sortDirection": "desc", "pageSize": 50 },
          "children": [
            {
              "type": "card",
              "props": { "variant": "outlined", "padding": "md" },
              "children": [
                {
                  "type": "row",
                  "props": { "justify": "between", "align": "start", "gap": "sm" },
                  "children": [
                    { "type": "text", "bind": "$item.text", "props": { "role": "body" } },
                    { "type": "button", "action": "remove", "props": { "label": "Delete", "accessibleLabel": "Delete note", "variant": "ghost", "tone": "danger", "icon": "trash-2", "args": { "id": "$item._id" } } }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
